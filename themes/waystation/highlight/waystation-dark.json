{
  "name": "waystation-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#161b23",
    "editor.foreground": "#e2e5e9"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#e2e5e9",
        "background": "#161b23"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d8692",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#d8b877"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b3c48f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#d8b877"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.struct",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#a8c8dc"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#f1f3f5"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a8c8dc"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b3c48f"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#d8b877"
      }
    }
  ]
}