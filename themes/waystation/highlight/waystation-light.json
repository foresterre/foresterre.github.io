{
  "name": "waystation-light",
  "type": "light",
  "colors": {
    "editor.background": "#ece7dc",
    "editor.foreground": "#1e1d1b"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#1e1d1b",
        "background": "#ece7dc"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d776c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#7a5520"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#56642f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#7a5520"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.struct",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#3a5568"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#1e1d1b"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3a5568"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#56642f"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#7a5520"
      }
    }
  ]
}